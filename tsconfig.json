{
  "compilerOptions": {
    "target": "ES2020",
    "module": "CommonJS",
    "moduleResolution": "Node",
    "strict": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "types": ["node", "@playwright/test"],
    "lib": ["ES2020", "DOM"],
    "noEmit": true,
    "skipLibCheck": true
  },
  "include": ["components/**/*.ts", "fixtures/**/*.ts", "pages/**/*.ts", "tests/**/*.ts", "utils/**/*.ts", "*.ts"]
}
