{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "moduleResolution": "node",
    "rootDir": "./",
    "baseUrl": ".",
    "paths": {
      "@config/*": ["./config/*"],
      "@controls/*": ["./controls/*"],
      "@pages/*": ["./pages/*"],
      "@utils/*": ["./utils/*"],
      "@data/*": ["./data/*"],
      "@fixtures/*": ["./fixtures/*"],
      "@test-helpers/*": ["./test-helpers/*"],
      "@api-setup/*": ["./api-setup/*"],
      "@test-business-rules/*": ["./test-business-rules/*"],
      "@services/*": ["./services/*"]
    },
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "noImplicitOverride": true,
    "types": ["node", "@playwright/test"],
    "lib": ["ES2020", "DOM"],
    "noEmit": true,
    "skipLibCheck": true
  },
  "exclude": [
    "node_modules",
    "test-results",
    "playwright-report",
    "blob-report",
    "dist",
    "coverage"
  ]
}
